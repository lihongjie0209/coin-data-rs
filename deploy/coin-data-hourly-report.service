[Unit]
Description=Send hourly coin data status report to Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/coin-data-rs.env
ExecStart=/usr/local/sbin/coin-data-hourly-report
Nice=10
CPUWeight=10
CPUQuota=5%
IOWeight=10
MemoryMax=64M
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coin-data-status

